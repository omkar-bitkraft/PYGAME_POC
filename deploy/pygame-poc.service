[Unit]
Description=Pygame POC backend service
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ec2-user
Group=ec2-user
SupplementaryGroups=docker
WorkingDirectory=/opt/pygame-poc
Environment=NODE_ENV=production
ExecStartPre=/usr/bin/docker build -t pygame-poc:latest .
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
